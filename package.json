{
  "name": "breakpoints",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "description": "See one web page at several device widths side by side, with device emulation, screenshots and overflow checks",
  "author": {
    "name": "Youssouf Kacemi",
    "email": "youssouf.kacemi@gmail.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/shared/*.test.ts",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "build": {
    "appId": "dev.dr1tch.breakpoints",
    "productName": "Breakpoints",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "breakpoints",
      "synopsis": "See a page at several device widths side by side"
    },
    "deb": {
      "artifactName": "${name}_amd64.deb"
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.4"
  },
  "homepage": "https://github.com/dr1tch"
}
